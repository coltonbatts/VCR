# 16:9 source for the aspect-adaptation task. Positions are pixels for a 1280x720 canvas.
version: 1
environment:
  resolution: { width: 1280, height: 720 }
  fps: 30
  duration: 3.0
layers:
  - id: backdrop
    z_index: 0
    procedural:
      kind: solid_color
      color: { r: 0.06, g: 0.09, b: 0.16, a: 1.0 }
  - id: headline
    z_index: 2
    position: { x: 90, y: 280 }
    text:
      content: "SUMMER LAUNCH"
      font_family: "GeistPixel-Line"
      font_size: 96
      color: { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
  - id: subline
    z_index: 2
    position: { x: 94, y: 410 }
    text:
      content: "Doors open at nine"
      font_family: "GeistPixel-Line"
      font_size: 44
      color: { r: 0.8, g: 0.85, b: 0.95, a: 1.0 }
