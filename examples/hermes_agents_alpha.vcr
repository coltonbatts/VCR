    procedural:
      kind: circle
      center: { x: 0.678, y: 0.668 }
      radius: 0.0072
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.95 }

  - id: snake_b_00
    z_index: 1
    pos_x: "sin(t * 0.14 + 3.14159) * -34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.353 }
      radius: 0.0066
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.88 }
  - id: snake_b_01
    z_index: 1
    pos_x: "sin(t * 0.14 + 3.14159 + 0.55) * -34"
    procedural:
