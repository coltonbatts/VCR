    procedural:
      kind: circle
      center: { x: 0.678, y: 0.503 }
      radius: 0.0066
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.88 }
  - id: snake_b_06
    z_index: 1
    pos_x: "sin(t * 0.14 + 3.14159 + 3.3) * -34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.533 }
      radius: 0.0066
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.88 }
  - id: snake_b_07
    z_index: 1
