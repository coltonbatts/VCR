    procedural:
      kind: circle
      center: { x: 0.678, y: 0.548 }
      radius: 0.0072
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.95 }
  - id: snake_a_08
    z_index: 1
    pos_x: "sin(t * 0.14 + 4.4) * 34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.578 }
      radius: 0.0072
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.95 }
  - id: snake_a_09
    z_index: 1
    pos_x: "sin(t * 0.14 + 4.95) * 34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.608 }
      radius: 0.0072
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.95 }
  - id: snake_a_10
    z_index: 1
    pos_x: "sin(t * 0.14 + 5.5) * 34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.638 }
      radius: 0.0072
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.95 }
  - id: snake_a_11
    z_index: 1
