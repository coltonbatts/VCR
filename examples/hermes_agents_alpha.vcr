      radius: 0.0066
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.88 }
  - id: snake_b_10
    z_index: 1
    pos_x: "sin(t * 0.14 + 3.14159 + 5.5) * -34"
    procedural:
      kind: circle
      center: { x: 0.678, y: 0.653 }
      radius: 0.0066
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.88 }

  # Typography — all white; slight pulse
  - id: title_hermes
    z_index: 20
    anchor: top_left
    position: { x: 96, y: 312 }
    opacity: "0.9 + 0.1 * sin(t * 0.08)"
    text:
      content: "HERMES"
      font_family: "GeistPixel-Line"
      font_size: 118
      color: { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }

  - id: title_agents
    z_index: 20
    anchor: top_left
    position: { x: 96, y: 452 }
    opacity: "0.9 + 0.1 * sin(t * 0.08 + 0.7)"
    text:
      content: "AGENTS"
      font_family: "GeistPixel-Line"
      font_size: 118
      color: { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }

  - id: tagline
    z_index: 21
    anchor: top_left
    position: { x: 104, y: 612 }
    text:
      content: "caduceus · Dr. Staff · winged wire"
      font_family: "GeistPixel-Square"
      font_size: 26
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.55 }

  - id: underline_pulse
    z_index: 19
    anchor: top_left
    pos_x: "96 + sin(t * 0.06) * 6"
    procedural:
      kind: rounded_rect
      center: { x: 0.192, y: 0.628 }
      size: { x: 0.38, y: 0.004 }
      corner_radius: 0.001
      color: { r: 1.0, g: 1.0, b: 1.0, a: 0.35 }
